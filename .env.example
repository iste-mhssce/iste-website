# Database (local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iste_nexus_db?schema=public"
# Direct connection used for migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/iste_nexus_db?schema=public"

# Supabase (replace with your project values)
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only admin gate for /api/admin/* routes. Set a strong secret.
# Used as a fallback Bearer key (the primary path is a logged-in ADMIN account).
ADMIN_API_KEY="your-admin-api-key"

# Required for the role-based session login (admin/head/member accounts).
# Set a strong random value (>= 16 chars).
AUTH_SECRET="your-long-random-secret"

# AI provider (server-only)
AI_PROVIDER_API_KEY="your-provider-key"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_CHAT_MODEL="your-chat-model"
AI_RATE_LIMIT_PER_MIN="20"
AI_EMBEDDING_DIM="1536"
