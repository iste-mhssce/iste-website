datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum EventType {
  WORKSHOP
  HACKATHON
  SEMINAR
  SUMMIT
}

enum IntakeStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  FLAGGED
}

model Certificate {
  id            String   @id @default(cuid())
  certificateId String   @unique
  studentName   String
  eventName     String
  issueDate     DateTime @default(now())
  pdfUrl        String?
  isVerified    Boolean  @default(true)
  riskScore     Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([certificateId])
}

model Event {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  category      EventType
  tag           String
  description   String
  startDate     DateTime
  location      String
  keynote       String?
  isFeatured    Boolean        @default(false)
  registrations Registration[]
  createdAt     DateTime       @default(now())

  @@index([category])
  @@index([startDate])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userName  String
  email     String
  phone     String
  teamName  String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([eventId])
  @@unique([eventId, email])
}

model CouncilMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  team      String
  photoUrl  String?
  email     String?
  bio       String?
  linkedin  String?
  instagram String?
  github    String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([team])
}

model IntakeApplication {
  id           String       @id @default(cuid())
  fullName     String
  email        String
  department   String
  yearOfStudy  String
  portfolioUrl String?
  status       IntakeStatus @default(PENDING)
  riskFlags    String[]     @default([])
  createdAt    DateTime     @default(now())

  @@index([email])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  body        String
  category    String
  author      String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published])
  @@index([category])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String?
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("general")
  pinned    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  actorName String?
  actorRole String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  team         String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([team])
}

model ChatSession {
  id        String        @id @default(cuid())
  userToken String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())

  @@index([userToken])
}

model ChatMessage {
  id           String       @id @default(cuid())
  sessionId    String
  session      ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String
  content      String
  retrievedIds String[]     @default([])
  createdAt    DateTime     @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
